{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauwitch",
  "version": "1.0.0",
  "identifier": "com.clauwitch.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clauwitch",
        "width": 980,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "backgroundColor": [0, 0, 0, 0],
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Clauwitch contributors",
    "shortDescription": "Switch between Claude Desktop accounts with saved sessions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
